PORT=3001
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-este-segredo-em-producao

# Configuração do distribuidor de e-mail (SMTP) para o formulário de contato.
# Exemplo com Gmail: use uma "senha de app" em SMTP_PASSWORD, nunca a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-usuario@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Para quem as mensagens do formulário serão enviadas
CONTACT_TO=contato@kairuarquitetura.com.br
# Remetente exibido no e-mail (se vazio, usa SMTP_USER)
CONTACT_FROM=seu-usuario@gmail.com
